PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

DATABASE_URL=YOUR_SUPABASE_POSTGRESQL_URL

MONGODB_URI=YOUR_MONGODB_ATLAS_CONNECTION_STRING

MONGODB_DB=campuslink

# Optional fallback for Node.js SRV DNS resolution issues.
# Leave blank unless the local resolver cannot resolve MongoDB Atlas SRV records then add 8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=

JWT_SECRET=REPLACE_WITH_A_LOCAL_SECRET
